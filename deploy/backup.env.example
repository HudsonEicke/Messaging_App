# Copy to /etc/beacon/backup.env, owned by root with mode 600.

# Folder holding compose.yaml and .env.
BEACON_DIR=/home/ubuntu/beacon

# rclone remote (and optional path) the dumps are uploaded to.
BACKUP_REMOTE=r2crypt:

# Where the newest dump is kept on the server.
# LOCAL_DIR=/var/backups/beacon

# Optional healthchecks.io ping URL, e.g. https://hc-ping.com/<uuid>
HEALTHCHECK_URL=
