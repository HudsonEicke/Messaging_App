###AUTH

###Register
POST {{Messaging_App_HostAddress}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@email.com",
  "password": "Test"
}

###Login
POST {{Messaging_App_HostAddress}}/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test"

}

###Refresh
POST {{Messaging_App_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "accessToken": "{{accessToken}}"
}

###Logout
POST {{Messaging_App_HostAddress}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###USER

###Me
GET {{Messaging_App_HostAddress}}/user/me
Authorization: Bearer {{accessToken}}

###Update ne
PUT {{Messaging_App_HostAddress}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "displayName": "TestUser",
  "profileImageUrl": "https://example.com/image.jpg"
}

###Update password
PUT {{Messaging_App_HostAddress}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "Test",
  "newPassword": "Test2"
}

###Update status
PUT {{Messaging_App_HostAddress}}/user/me/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "activityStatus": 0
}

###Get user info by username
@username=testuser
GET {{Messaging_App_HostAddress}}/user/username/{{username}}
Authorization: Bearer {{accessToken}}

###Get user by id
@id=1
GET {{Messaging_App_HostAddress}}/user/{{id}}
Authorization: Bearer {{accessToken}}

###Sever

###Create Server
POST {{Messaging_App_HostAddress}}/server/createserver
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "serverName": "Test Server 1"
}

###Get servers for user
GET {{Messaging_App_HostAddress}}/server/servers
Authorization: Bearer {{accessToken}}

###Get server info
@id=1
GET {{Messaging_App_HostAddress}}/server/{{id}}
Authorization: Bearer {{accessToken}}

###Get server members
@id=1
GET {{Messaging_App_HostAddress}}/server/{{id}}/members
Authorization: Bearer {{accessToken}}

###Update server info
@id=1
PUT {{Messaging_App_HostAddress}}/server/{{id}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "serverName": "TestServer"
  "serverImageUrl": "https://example.com/image.jpg"
}

###Delete server
@id=1
DELETE {{Messaging_App_HostAddress}}/server/{{id}}
Authorization: Bearer {{accessToken}}

###Leave server
@id=1
POST {{Messaging_App_HostAddress}}/server/{{id}}/leave
Authorization: Bearer {{accessToken}}

###Kick member
@id=1
@username="testuser"
DELETE {{Messaging_App_HostAddress}}/server/{{id}}/members/{{username}}
Authorization: Bearer {{accessToken}}

###Channel

