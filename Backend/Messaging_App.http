###AUTH

POST {{Messaging_App_HostAddress}}/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@email.com",
  "password": "Test"
}

###

POST {{Messaging_App_HostAddress}}/auth/login
Content-Type: application/json

{
  "username": "testuser",
  "password": "Test2"

}

###

POST {{Messaging_App_HostAddress}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}",
  "accessToken": "{{accessToken}}"
}

###


POST {{Messaging_App_HostAddress}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###USER

GET {{Messaging_App_HostAddress}}/user/me
Authorization: Bearer {{accessToken}}

###

PUT {{Messaging_App_HostAddress}}/user/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "displayName": "TestUser",
  "profileImageUrl": "https://example.com/image.jpg"
}

###

PUT {{Messaging_App_HostAddress}}/user/me/password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "currentPassword": "Test",
  "newPassword": "Test2"
}

###

PUT {{Messaging_App_HostAddress}}/user/me/status
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "activityStatus": 0
}

###

@username=testuser
GET {{Messaging_App_HostAddress}}/user/username/{{username}}
Authorization: Bearer {{accessToken}}

###

@id=1
GET {{Messaging_App_HostAddress}}/user/{{id}}
Authorization: Bearer {{accessToken}}

###Sever

POST {{Messaging_App_HostAddress}}/server/createserver
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "serverName": "Test Server 2"
}

###
