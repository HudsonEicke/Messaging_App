{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "MessagingAppContext": "Host=localhost;Database=messaging_app;Username=your_postgres_username_here;Password=your_postgres_password_here"
  },
  "JwtSettings": {
    "SecretKey": "your_long_random_secret_key_here",
    "Issuer": "http://localhost",
    "Audience": "MessagingAppAPI",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "EncryptionSettings": {
      "SecretKey": "your_long_random_secret_key_here"
  },
  "AllowedOrigins": ["http://localhost:3000"],
  "AllowedHosts": "*"
}
