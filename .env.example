# Copy this file to .env and fill in every value. Never commit .env.
# Generate each secret with: openssl rand -hex 32

# Address Caddy serves the site on.
# Local: http://localhost (plain HTTP, no certificate)
# Server: your domain without a scheme, e.g. chat.example.com (HTTPS via Let's Encrypt)
DOMAIN=http://localhost

# Only used the first time the database volume is created. Changing it later
# doesn't change the database's password, so the API won't be able to connect.
POSTGRES_PASSWORD=

# Signs login tokens. Changing it logs everyone out.
JWT_SECRET_KEY=

# Encrypts data stored in the database. Never change it once there's data,
# or that data can't be decrypted.
ENCRYPTION_SECRET_KEY=
